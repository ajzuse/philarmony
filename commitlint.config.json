{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "header-max-length": [2, "always", 72],
    "type-enum": [
      2,
      "always",
      [
        "feat",
        "fix",
        "docs",
        "style",
        "refactor",
        "perf",
        "test",
        "chore",
        "ci",
        "build",
        "revert",
        "security",
        "deps"
      ]
    ],
    "scope-enum": [
      2,
      "always",
      [
        "hardware",
        "software",
        "docs",
        "tests",
        "ci",
        "deps",
        "build",
        "perf",
        "refactor",
        "style",
        "feat",
        "fix",
        "chore"
      ]
    ],
    "subject-max-length": [2, "always", 72],
    "subject-case": [2, "always", "sentence-case"]
  }
}